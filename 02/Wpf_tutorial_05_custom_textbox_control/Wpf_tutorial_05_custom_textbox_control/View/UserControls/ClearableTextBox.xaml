<UserControl x:Class="Wpf_tutorial_05_custom_textbox_control.View.UserControls.ClearableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Wpf_tutorial_05_custom_textbox_control.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250">
    <Grid Background="White">
        <TextBox Name="txtInput" VerticalContentAlignment="Center"
                 FontSize="16" FontWeight="Light" Background="Transparent"
                 TextChanged="txtInput_TextChanged"
                 />
        <TextBlock Name="tbPlaceholder" Text="{Binding Placeholder}" FontSize="16" FontWeight="Light"
                   Foreground="DarkGray" VerticalAlignment="Center" Margin="5,0,0,0"
                   Panel.ZIndex="-1"
                   />
        <Button Name="btnClear" Width="30" HorizontalAlignment="Right" Content="X"
                Background="Transparent" Foreground="LightGray" BorderThickness="0"
                Click="btnClear_Click"/>
    </Grid>
</UserControl>
