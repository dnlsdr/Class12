<Window x:Class="Wpf_tutorial_05_custom_textbox_control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_tutorial_05_custom_textbox_control"
        xmlns:userControls="clr-namespace:Wpf_tutorial_05_custom_textbox_control.View.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="300">
    <Grid>
        <!--Main window height és width atallitasa, mert fillout form-->
        <!--fillout form, első sor valami szoveg, utolsó sor egy gomb, hogy submit, a többi pedig
        kitöltendő mező-->
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <userControls:ClearableTextBox Grid.Row="1" Width="250" Height="40" Placeholder="First name"/>
        <userControls:ClearableTextBox Grid.Row="2" Width="250" Height="40" Placeholder="last name"/>
        <userControls:ClearableTextBox Grid.Row="3" Width="250" Height="40" Placeholder="email name"/>
        <userControls:ClearableTextBox Grid.Row="4" Width="250" Height="40" Placeholder="phone name"/>

    </Grid>
</Window>
